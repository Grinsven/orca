    "terminalQuickCommands": [
      {
        "id": "jose-claude",
        "label": "claude (tmux)",
        "scope": {
          "type": "global"
        },
        "action": "terminal-command",
        "command": "/opt/homebrew/bin/tmux new-session \\; set-option destroy-unattached on \\; send-keys \"command claude --dangerously-skip-permissions\" Enter",
        "appendEnter": true
      },
      {
        "id": "jose-claudex",
        "label": "claudex (tmux)",
        "scope": {
          "type": "global"
        },
        "action": "terminal-command",
        "command": "/opt/homebrew/bin/tmux new-session \\; set-option destroy-unattached on \\; send-keys \"claudex\" Enter",
        "appendEnter": true
      },
      {
        "id": "jose-codex",
        "label": "codex (tmux)",
        "scope": {
          "type": "global"
        },
        "action": "terminal-command",
        "command": "/opt/homebrew/bin/tmux new-session \\; set-option destroy-unattached on \\; send-keys \"command codex --dangerously-bypass-approvals-and-sandbox\" Enter",
